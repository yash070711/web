        "nxtPstudio": "nxtPstudio"
      },
      "namedRegex": "^/products/(?<nxtPid>[^/]+?)/(?<nxtPstudio>[^/]+?)(?:/)?$"
    },
    {
      "page": "/proto/[...path]",
      "regex": "^/proto/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/proto/(?<nxtPpath>.+?)(?:/)?$"
    }
