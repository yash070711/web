{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/runtime/products/[id]",
      "regex": "^/api/runtime/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/runtime/products/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/runtime/products/[id]/quote",
      "regex": "^/api/runtime/products/([^/]+?)/quote(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
